<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    </style>
    <!-- 찜 목록 화면 상단 타이틀(TextView)에 적용할 스타일 -->
    <style name="TitleMedium">
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Headline6</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="Toolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 줄바꿈-->
    <style name="TextMultiline">
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
        <item name="android:scrollHorizontally">false</item>
    </style>

    <style name="CategoryItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="RowItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="RowItemTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#242729</item>
    </style>

    <style name="RowChevronStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#EFEFEF</item>
    </style>
    <style name="Chip.Tab" parent="Widget.MaterialComponents.Chip.Filter">
        <!-- 크기 기본값을 스타일에서 강제 -->
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>

        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_tab_stroke</item>
        <item name="chipBackgroundColor">@color/chip_tab_bg</item>
        <item name="android:textColor">@color/chip_tab_text</item>

        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SpotRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#666</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="SpotRowValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#333</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="Row.Info">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Row.Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">#6B6B6B</item>
    </style>

    <style name="Row.Texts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Row.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#7A7A7A</item>
    </style>

    <style name="Row.Value">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="Row.Action">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2C9E46</item> <!-- 포인트 색 -->
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="Row.Chevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">#A0A0A0</item>
    </style>

    <style name="Row.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#EEEEEE</item>
    </style>
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>