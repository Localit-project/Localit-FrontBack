<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragment.MypageFragment"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:baselineAligned="false"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="마이페이지"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 알림 아이콘 + 뱃지 -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageButton
                android:id="@+id/btnNotification"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications"
                app:srcCompat="@drawable/ic_notifications_24" />

            <TextView
                android:id="@+id/badgeNew"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 프로필 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_avatar_placeholder" />

                    <ImageButton
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_add_circle"
                        android:contentDescription="@string/add_photo"
                        app:srcCompat="@drawable/baseline_add_24" />
                </FrameLayout>
            </LinearLayout>

            <!-- 닉네임 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="닉네임"
                android:textColor="#242729"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etNickname"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_edittext_round"
                    android:hint="2~10자로 입력해 주세요"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLength="10"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/tvNickRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 이모티콘 및 특수기호, 띄어쓰기 사용이 불가능합니다."
                    android:textColor="#6F6F6F"
                    android:textSize="12sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#F6F6F6" />

            <!-- 메뉴들 -->
            <LinearLayout
                android:id="@+id/rowAlarm"
                style="@style/RowItemStyle">
                <TextView
                    style="@style/RowItemTextStyle"
                    android:text="알림 설정"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageView
                    style="@style/RowChevronStyle"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <LinearLayout
                android:id="@+id/rowLogout"
                style="@style/RowItemStyle">
                <TextView
                    style="@style/RowItemTextStyle"
                    android:text="로그아웃"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <ImageView
                    style="@style/RowChevronStyle"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </LinearLayout>


            <View style="@style/DividerStyle"/>

            <LinearLayout
                android:id="@+id/rowWithdraw"
                style="@style/RowItemStyle">
                <TextView
                    style="@style/RowItemTextStyle"
                    android:text="회원탈퇴"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <ImageView
                    style="@style/RowChevronStyle"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
