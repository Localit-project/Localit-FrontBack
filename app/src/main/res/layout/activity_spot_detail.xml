<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- 스크롤 내부 컨테이너는 하나여야 해요 -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 상단 바 -->
        <LinearLayout
            android:id="@+id/Bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="25dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="상세 정보"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center" />

            <Space
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <!-- 제목 -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222" />

        <!-- 대표 사진 -->
        <ImageView
            android:id="@+id/imageMain"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_image_round"
            android:contentDescription="@string/app_name"/>

        <!-- 보조사진 가로 갤러리 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerGallery"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"/>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- 개요(상세설명) -->
        <TextView
            android:id="@+id/textOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#444"
            android:lineSpacingExtra="4dp" />

        <!-- 주소 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="주소"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/textAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444" />

        <!-- 우편번호(필요 시 표시) -->
        <TextView
            android:id="@+id/labelZip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="우편번호"
            android:textStyle="bold"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/textZipcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"
            android:visibility="gone"/>

        <!-- 문의 및 안내 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="문의 및 안내"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/textTel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"/>

        <!-- 쉬는날 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="쉬는날"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/textRestdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"/>

        <!-- 이용시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이용시간"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/textUsetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"/>

        <!-- 주차시설 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주차시설"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/textParking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"/>

        <!-- 입장료 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="입장료"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/textUsefee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444"/>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- 지도 -->
        <com.naver.maps.map.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp" />


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
