<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/textRegionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="상세 정보"
            android:layout_marginTop="25dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- 본문 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- NestedScrollView 자식은 1개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 제목 -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222" />

            <!-- 대표 사진 -->
            <ImageView
                android:id="@+id/imageMain"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/bg_image_round"
                android:contentDescription="@string/app_name"/>

            <!-- ===== 기본 정보 섹션 ===== -->
            <LinearLayout
                android:id="@+id/infoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_info_section_round"
                android:padding="12dp">

                <!-- 주소 -->
                <LinearLayout
                    android:id="@+id/textAddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_location_on_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="주소"
                            android:textSize="12sp"
                            android:textColor="#7A7A7A" />

                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCopyAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="복사"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#2C9E46" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- 홈페이지 -->
                <LinearLayout
                    android:id="@+id/rowHomepage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_language_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="홈페이지"
                            android:textSize="12sp"
                            android:textColor="#7A7A7A" />

                        <TextView
                            android:id="@+id/tvHomepage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoLink="web"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenSite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="사이트 이동"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#2C9E46" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- 추가정보(개요) -->
                <LinearLayout
                    android:id="@+id/textExtraInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="추가정보"
                            android:textSize="12sp"
                            android:textColor="#7A7A7A" />

                        <TextView
                            android:id="@+id/tvExtra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp"
                            android:text="" />

                        <!-- ===== 코스정보 섹션 (detailIntro1) ===== -->
                        <LinearLayout
                            android:id="@+id/sectionCourseInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_info_section_round"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="코스정보"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="#222"
                                android:paddingBottom="8dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCourseSchedule"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="일정: -"
                                    android:textSize="14sp"
                                    android:textColor="#333333"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"/>

                                <TextView
                                    android:id="@+id/tvCourseDistance"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="거리: -"
                                    android:textSize="14sp"
                                    android:textColor="#333333"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"/>

                                <TextView
                                    android:id="@+id/tvCourseTaketime"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="소요시간: -"
                                    android:textSize="14sp"
                                    android:textColor="#333333"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"/>

                                <TextView
                                    android:id="@+id/tvCourseTheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="테마: -"
                                    android:textSize="14sp"
                                    android:textColor="#333333"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ===== 여행 코스 리스트 (detailInfo1) ===== -->
                        <LinearLayout
                            android:id="@+id/sectionCourseList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_info_section_round"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="여행 코스"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="#222"
                                android:paddingBottom="8dp"/>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerCourseSteps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 하단 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 내비 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="unlabeled" />

    <!-- 로딩/에러(옵션) -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="데이터를 불러오지 못했습니다."
        android:textSize="16sp"
        android:textColor="#000"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="100dp"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
