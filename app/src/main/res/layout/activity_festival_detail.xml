<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 제목 -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222" />

        <!-- 대표 이미지 -->
        <ImageView
            android:id="@+id/imageMain"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_image_round" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- 공통 정보 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="우편번호" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvZipcode"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="전화명" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvTelName"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="전화번호" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvTel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="주소" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvAddr"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="개요" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvOverview"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#444" android:lineSpacingExtra="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- 축제 인트로 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="주최" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvSponsor1"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="주최 연락처" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvSponsor1Tel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="주관" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvSponsor2"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="행사 시작일" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvStartDate"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="행사 종료일" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvEndDate"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="공연시간" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvPlaytime"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="진행형태" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvProgressType"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="축제형태" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvFestivalType"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#444"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="행사소개" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvProgram"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#444" android:lineSpacingExtra="4dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="행사내용" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvContent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#444" android:lineSpacingExtra="4dp"/>
        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- 지도 -->
        <com.naver.maps.map.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
