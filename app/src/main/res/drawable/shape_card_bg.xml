<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 흰 배경 -->
    <solid android:color="#FFFFFF" />

    <!-- 모서리 둥글게 -->
    <corners android:radius="8dp" />

    <!-- 살짝 회색 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#22000000" />

    <!-- 안쪽 여백 느낌 (그림자 대체용) -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>
